rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 's16677481@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Buyer preference questionnaires
    match /buyerPreferences/{userId} {
      allow read, write: if true;
    }

    // Land and Property Listings
    match /properties/{propertyId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Property Legal Documents
    match /propertyDocuments/{docId} {
      allow read, write: if true;
    }

    // Conversations between Buyer & Seller
    match /conversations/{conversationId} {
      allow read, write: if true;
    }

    // Messages inside conversations
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Site visit booking & status management
    match /siteVisits/{visitId} {
      allow read, write: if true;
    }

    // Saved property bookmarks (Wishlist)
    match /savedProperties/{saveId} {
      allow read, write: if true;
    }

    // Notifications
    match /notifications/{notifId} {
      allow read, write: if true;
    }
  }
}
